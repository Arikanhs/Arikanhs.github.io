---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import CommandPalette from '../components/ui/CommandPalette.astro';
import { SITE } from '../lib/site';
import '../styles/global.css';

interface Props {
  /** Page title; the site name is appended. Omit it on the home page. */
  title?: string;
  description?: string;
  /** Social preview image (path in public/ or absolute URL). */
  image?: string;
  /** "article" for blog posts, with their publication date. */
  type?: 'website' | 'article';
  published?: Date;
  /** Keep the page out of search results (the 404 page). */
  noindex?: boolean;
  /** Color theme (global.css); by default from the section of the site. */
  theme?: Theme;
}

type Theme = keyof typeof THEME_COLORS;

/** Browser UI color per theme: the left end of its wash (--color-bg). */
const THEME_COLORS = {
  home: '#0f52ba',
  projects: '#87ceeb',
  publications: '#ff5349',
  blog: '#2a0a6b',
  resume: '#141416',
} as const;
/** Light text on a dark page (global.css sets color-scheme: dark for these too). */
const DARK_THEMES = new Set<Theme>(['home', 'resume', 'blog']);
/** The home page and every tab (with their sub-pages) have themes; the rest (404) is cream. */
const SECTION_THEMES: Record<string, Theme> = {
  '': 'home',
  projects: 'projects',
  publications: 'publications',
  blog: 'blog',
  resume: 'resume',
};

const { title, description = SITE.description, image = '/og.png', type = 'website', published, noindex = false } =
  Astro.props;
const theme: Theme | undefined = Astro.props.theme ?? SECTION_THEMES[Astro.url.pathname.split('/')[1] ?? ''];
const fullTitle = title ? `${title} | ${SITE.name}` : SITE.name;
const site = Astro.site ?? new URL(SITE.url);
const canonical = new URL(Astro.url.pathname, site).href;
const imageUrl = new URL(image, site).href;
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add('js');
      // Client-side navigation copies <html> attributes from the new page, which
      // lacks the class; add it before the swap so the layout never flickers.
      document.addEventListener('astro:before-swap', (event) => {
        event.newDocument.documentElement.classList.add('js');
      });
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name}: ${SITE.intro}`} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="color-scheme" content={theme && DARK_THEMES.has(theme) ? 'dark' : 'light'} />
    <meta name="theme-color" content={theme ? THEME_COLORS[theme] : '#f5efe3'} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name}: blog`} href="/rss.xml" />
    <Font
      cssVariable="--font-plex-mono"
      preload={[
        { subset: 'latin', style: 'normal', weight: '400' },
        { subset: 'latin', style: 'normal', weight: '600' },
      ]}
    />
    <Font cssVariable="--font-source-serif" preload={[{ subset: 'latin', style: 'normal' }]} />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" tabindex="-1" class="flex-1">
      <slot />
    </main>
    <SiteFooter />
    <CommandPalette />
    <script>
      // Scroll reveal: [data-reveal] elements below the fold fade up once as they
      // enter the viewport. Anything already on screen is never hidden, so the
      // first paint is complete. The hidden state needs JS and motion allowed.
      function initReveal() {
        const targets = [...document.querySelectorAll('[data-reveal]:not(.is-revealed)')].filter((el) => {
          if (el.getBoundingClientRect().top < window.innerHeight) return false;
          el.classList.add('reveal-pending');
          return true;
        });
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-revealed');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        for (const target of targets) observer.observe(target);
      }
      document.addEventListener('astro:page-load', initReveal);
    </script>
  </body>
</html>
