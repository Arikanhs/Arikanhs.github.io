---
import { SITE } from '../../lib/site';

const year = new Date().getFullYear();
const links = [
  { label: 'GitHub', value: `github.com/${SITE.github}`, href: SITE.githubUrl, rel: 'me' },
  { label: 'LinkedIn', value: 'in/hasan-serdar-arikan', href: SITE.linkedinUrl, rel: 'me' },
  { label: 'Email', value: SITE.email, href: `mailto:${SITE.email}` },
];
---

<footer class="site-footer">
  <div class="container-page">
    <h2 class="title"><span class="prompt" aria-hidden="true">$</span> contact</h2>
    <ul class="links">
      {
        links.map((link) => (
          <li>
            <a href={link.href} rel={link.rel}>
              <span class="label">{link.label}</span>
              <span class="value">{link.value}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="meta">&copy; {year} {SITE.name}. Built with Astro.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--section);
    border-top: 1px solid var(--color-line);
    padding-block: 2.5rem 3rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .title {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-muted);
  }

  .prompt {
    color: var(--color-accent-text);
  }

  .links {
    margin-top: 1rem;
    display: grid;
    gap: 0.25rem;
  }

  .links a {
    display: inline-grid;
    grid-template-columns: 10ch auto;
    align-items: baseline;
    padding-block: 0.375rem;
    text-decoration: none;
  }

  .label {
    color: var(--color-muted);
  }

  .value {
    color: var(--color-fg);
    overflow-wrap: anywhere;
    text-decoration-line: underline;
    text-decoration-color: color-mix(in oklab, var(--color-accent-text) 55%, transparent);
    text-underline-offset: 0.3em;
    transition: color 150ms;
  }

  .links a:hover .value {
    color: var(--color-accent-text);
    text-decoration-color: var(--color-accent-text);
  }

  .meta {
    margin-top: 2rem;
    color: var(--color-faint);
    font-size: 0.8125rem;
  }
</style>
