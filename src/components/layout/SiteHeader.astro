---
import { NAV } from '../../lib/site';

const raw = Astro.url.pathname;
const path = raw.endsWith('/') ? raw : `${raw}/`;

/** "page" for the current page, "true" for its section (e.g. a project page). */
function current(href: string) {
  if (href === path) return 'page';
  if (href !== '/' && path.startsWith(href)) return 'true';
  return undefined;
}
---

<header class="site-header">
  <div class="container-page bar">
    <a href="/" class="wordmark"><span class="prompt" aria-hidden="true">&gt;_</span>hasan arikan</a>
    <nav class="site-nav" aria-label="Main">
      <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="nav-links" hidden>
        <span class="toggle-icon" aria-hidden="true"></span>
        Menu
      </button>
      <ul id="nav-links" class="nav-links">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={current(item.href)}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  // Mobile menu: a disclosure button that shows/hides the nav list. Without JS
  // the button stays hidden and the list simply wraps under the wordmark.
  function initNav() {
    const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
    const list = document.getElementById('nav-links');
    const nav = toggle?.closest('nav');
    if (!toggle || !list || !nav || toggle.dataset.ready) return;
    toggle.dataset.ready = '';
    toggle.hidden = false;

    const controller = new AbortController();
    const { signal } = controller;
    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      list.toggleAttribute('data-open', open);
    };

    toggle.addEventListener('click', () => setOpen(!isOpen()), { signal });
    nav.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'Escape' && isOpen()) {
          setOpen(false);
          toggle.focus();
        }
      },
      { signal },
    );
    // Close when focus leaves the menu (Tab past the last link, click elsewhere).
    nav.addEventListener(
      'focusout',
      (event) => {
        if (isOpen() && !nav.contains(event.relatedTarget as Node | null)) setOpen(false);
      },
      { signal },
    );
    list.addEventListener(
      'click',
      (event) => {
        if ((event.target as Element).closest('a')) setOpen(false);
      },
      { signal },
    );
    window.matchMedia('(min-width: 48rem)').addEventListener('change', () => setOpen(false), { signal });
    document.addEventListener('astro:before-swap', () => controller.abort(), { once: true });
  }

  // With <ClientRouter />, astro:page-load fires on the first load and after
  // every navigation (the header is new each time; initNav guards re-entry).
  document.addEventListener('astro:page-load', initNav);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid var(--color-line);
    background-color: color-mix(in oklab, var(--color-bg) 84%, transparent);
    backdrop-filter: blur(10px);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    column-gap: 1.5rem;
    min-height: var(--header-h);
    padding-block: 0.375rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding-block: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-fg);
    text-decoration: none;
  }

  .prompt {
    color: var(--color-accent);
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .nav-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding-block: 0.5rem;
    color: var(--color-muted);
    text-transform: lowercase;
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.4em;
    transition:
      color 150ms,
      text-decoration-color 150ms;
  }

  .nav-links a:hover {
    color: var(--color-fg);
    text-decoration-color: var(--color-accent);
  }

  .nav-links a[aria-current] {
    color: var(--color-fg);
  }

  /* The current page is marked with the phosphor cursor block. */
  .nav-links a[aria-current]::before {
    content: '';
    width: 0.5em;
    height: 1.05em;
    background-color: var(--color-accent);
  }

  .nav-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    padding-inline: 0.875rem;
    border: 1px solid var(--color-line);
    border-radius: 2px;
    background-color: var(--color-surface);
    color: var(--color-fg);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    text-transform: lowercase;
    cursor: pointer;
  }

  .nav-toggle:hover {
    border-color: var(--color-faint);
  }

  /* Three bars that fold into an X when open. */
  .toggle-icon {
    position: relative;
    width: 1rem;
    height: 2px;
    background-color: currentColor;
    transition: background-color 150ms;
  }

  .toggle-icon::before,
  .toggle-icon::after {
    content: '';
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: currentColor;
    transition: transform 200ms;
  }

  .toggle-icon::before {
    transform: translateY(-5px);
  }

  .toggle-icon::after {
    transform: translateY(5px);
  }

  .nav-toggle[aria-expanded='true'] .toggle-icon {
    background-color: transparent;
  }

  .nav-toggle[aria-expanded='true'] .toggle-icon::before {
    transform: rotate(45deg);
  }

  .nav-toggle[aria-expanded='true'] .toggle-icon::after {
    transform: rotate(-45deg);
  }

  @media (min-width: 48rem) {
    .nav-toggle {
      display: none;
    }
  }

  @media (max-width: 47.99rem) {
    :global(.js) .nav-links {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      display: none;
      flex-direction: column;
      padding: 0.5rem var(--gutter) 1rem;
      border-bottom: 1px solid var(--color-line);
      background-color: var(--color-surface);
    }

    :global(.js) .nav-links[data-open] {
      display: flex;
    }

    :global(.js) .nav-links a {
      width: 100%;
      padding-block: 0.75rem;
      font-size: 1rem;
    }

    /* Keep labels aligned in the vertical list. */
    :global(.js) .nav-links a::before {
      content: '';
      width: 0.5em;
      height: 1.05em;
    }
  }
</style>
