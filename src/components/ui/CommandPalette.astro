---
// Command palette: Ctrl+K / Cmd+K or the header button. A modal <dialog> with
// the ARIA combobox pattern: focus stays in the input, arrow keys move the
// active option, Enter opens it, Esc closes. The index is built at build time.
import { getPosts, getProjects, getPublications } from '../../lib/content';
import { NAV } from '../../lib/site';

const [projects, publications, posts] = await Promise.all([getProjects(), getPublications(), getPosts()]);
const items = [
  ...NAV.map((item) => ({ kind: 'page', title: item.label, href: item.href, hint: item.href })),
  ...projects.map((p) => ({
    kind: 'project',
    title: p.data.title,
    href: `/projects/${p.id}/`,
    hint: p.data.tags.join(' '),
  })),
  ...publications.map((p) => ({
    kind: 'paper',
    title: p.data.title,
    href: `/publications/#${p.id}`,
    hint: `${p.data.venue} ${p.data.year}`,
  })),
  ...posts.map((p) => ({ kind: 'post', title: p.data.title, href: `/blog/${p.id}/`, hint: p.data.tags.join(' ') })),
];
---

<dialog class="palette" id="command-palette" aria-labelledby="palette-title">
  <div class="panel">
    <h2 id="palette-title" class="sr-only">Command palette</h2>
    <div class="field">
      <span class="prompt" aria-hidden="true">~ $</span>
      <input
        type="text"
        role="combobox"
        aria-expanded="true"
        aria-controls="palette-results"
        aria-autocomplete="list"
        aria-label="Search pages, projects, papers and posts"
        placeholder="Search pages, projects, papers, posts…"
        autocomplete="off"
        spellcheck="false"
        data-palette-input
      />
      <button type="button" class="close" data-palette-close aria-label="Close">esc</button>
    </div>
    <ul id="palette-results" class="results" role="listbox" aria-label="Results" data-palette-results></ul>
    <p class="empty" data-palette-empty hidden>No matches.</p>
    <p class="hints" aria-hidden="true">
      <span><kbd>↑</kbd><kbd>↓</kbd> move</span><span><kbd>↵</kbd> open</span><span><kbd>esc</kbd> close</span>
    </p>
    <p class="sr-only" role="status" aria-live="polite" data-palette-status></p>
  </div>
  <script type="application/json" data-palette-index set:html={JSON.stringify(items)} />
</dialog>

<script>
  import { navigate } from 'astro:transitions/client';
  import { fuzzyScore } from '../../lib/fuzzy';

  interface Item {
    kind: string;
    title: string;
    href: string;
    hint: string;
  }

  let active = 0;
  let matches: Item[] = [];

  const dialog = () => document.getElementById('command-palette') as HTMLDialogElement | null;

  function render() {
    const d = dialog();
    if (!d) return;
    const input = d.querySelector<HTMLInputElement>('[data-palette-input]')!;
    const list = d.querySelector<HTMLUListElement>('[data-palette-results]')!;
    const items = JSON.parse(d.querySelector('[data-palette-index]')!.textContent ?? '[]') as Item[];
    const query = input.value.trim();
    matches = query
      ? items
          .map((item) => ({ item, score: Math.max(fuzzyScore(query, item.title), fuzzyScore(query, item.hint) - 5) }))
          .filter((m) => m.score > 0)
          .sort((a, b) => b.score - a.score)
          .map((m) => m.item)
      : items;
    active = Math.min(active, Math.max(0, matches.length - 1));
    list.replaceChildren(
      ...matches.map((item, i) => {
        const li = document.createElement('li');
        li.id = `palette-option-${i}`;
        li.role = 'option';
        li.className = 'option';
        li.setAttribute('aria-selected', String(i === active));
        li.dataset.href = item.href;
        const kind = document.createElement('span');
        kind.className = 'kind';
        kind.textContent = item.kind;
        const title = document.createElement('span');
        title.className = 'title';
        title.textContent = item.title;
        li.append(kind, title);
        li.addEventListener('click', () => open(item.href));
        li.addEventListener('pointermove', () => setActive(i));
        return li;
      }),
    );
    input.setAttribute('aria-activedescendant', matches.length ? `palette-option-${active}` : '');
    d.querySelector<HTMLElement>('[data-palette-empty]')!.hidden = matches.length > 0;
    d.querySelector<HTMLElement>('[data-palette-status]')!.textContent = `${matches.length} result${matches.length === 1 ? '' : 's'}`;
  }

  function setActive(index: number) {
    const d = dialog();
    if (!d || !matches.length) return;
    active = (index + matches.length) % matches.length;
    for (const option of d.querySelectorAll('[role="option"]')) {
      option.setAttribute('aria-selected', String(option.id === `palette-option-${active}`));
    }
    d.querySelector('[data-palette-input]')!.setAttribute('aria-activedescendant', `palette-option-${active}`);
    d.querySelector(`#palette-option-${active}`)?.scrollIntoView({ block: 'nearest' });
  }

  function open(href: string) {
    dialog()?.close();
    void navigate(href);
  }

  function show() {
    const d = dialog();
    if (!d || d.open) return;
    const input = d.querySelector<HTMLInputElement>('[data-palette-input]')!;
    input.value = '';
    active = 0;
    render();
    d.showModal();
    input.focus();
  }

  function initPalette() {
    const d = dialog();
    if (!d || d.dataset.ready) return;
    d.dataset.ready = '';
    const input = d.querySelector<HTMLInputElement>('[data-palette-input]')!;
    const close = d.querySelector<HTMLButtonElement>('[data-palette-close]')!;
    input.addEventListener('input', () => {
      active = 0;
      render();
    });
    d.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        setActive(active + (event.key === 'ArrowDown' ? 1 : -1));
      } else if (event.key === 'Enter' && event.target === input) {
        event.preventDefault();
        const item = matches[active];
        if (item) open(item.href);
      } else if (event.key === 'Tab') {
        // Keep focus inside: the input and the close button are the only stops.
        event.preventDefault();
        (document.activeElement === input ? close : input).focus();
      }
    });
    close.addEventListener('click', () => d.close());
    // Click on the backdrop closes it.
    d.addEventListener('click', (event) => {
      if (event.target === d) d.close();
    });
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-palette-open]')) {
      button.hidden = false;
      button.addEventListener('click', show);
    }
  }

  document.addEventListener('keydown', (event) => {
    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      const d = dialog();
      if (d?.open) d.close();
      else show();
    }
  });
  document.addEventListener('astro:page-load', initPalette);
</script>

<style>
  .palette {
    width: min(40rem, calc(100vw - 2rem));
    max-height: min(32rem, calc(100dvh - 4rem));
    margin: 12vh auto auto;
    padding: 0;
    border: 1px solid color-mix(in oklab, var(--color-accent) 55%, var(--color-line));
    border-radius: 4px;
    background-color: var(--color-surface);
    color: var(--color-fg);
    box-shadow: 0 30px 80px -30px rgb(0 0 0 / 0.8);
    font-family: var(--font-mono);
  }

  .palette::backdrop {
    background-color: rgb(13 12 11 / 0.72);
    backdrop-filter: blur(3px);
  }

  .panel {
    display: flex;
    flex-direction: column;
    max-height: inherit;
  }

  .field {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    border-bottom: 1px solid var(--color-line);
  }

  .prompt {
    color: var(--color-accent);
  }

  input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--color-fg);
    font: inherit;
    font-size: 1rem;
  }

  input:focus-visible {
    outline: none;
  }

  input::placeholder {
    color: var(--color-muted);
  }

  .close {
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--color-line);
    border-radius: 2px;
    background: transparent;
    color: var(--color-muted);
    font: inherit;
    font-size: 0.75rem;
    cursor: pointer;
  }

  .results {
    overflow-y: auto;
    padding: 0.5rem;
  }

  .results :global(.option) {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.625rem 0.75rem;
    border-radius: 2px;
    cursor: pointer;
  }

  .results :global(.option[aria-selected='true']) {
    background-color: var(--color-accent);
    color: var(--color-accent-ink);
  }

  .results :global(.kind) {
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .results :global(.option[aria-selected='true'] .kind) {
    color: var(--color-accent-ink);
  }

  .results :global(.title) {
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  .empty {
    padding: 1rem 1.25rem;
    color: var(--color-muted);
  }

  .hints {
    display: flex;
    gap: 1.25rem;
    padding: 0.625rem 1rem;
    border-top: 1px solid var(--color-line);
    color: var(--color-muted);
    font-size: 0.75rem;
  }

  kbd {
    margin-right: 0.25rem;
    padding: 0 0.3rem;
    border: 1px solid var(--color-line);
    border-radius: 2px;
    font: inherit;
  }
</style>
