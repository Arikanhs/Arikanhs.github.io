---
import type { CollectionEntry } from 'astro:content';
import { displayUrl } from '../../lib/format';
import TagList from './TagList.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { title, summary, tags, repo } = Astro.props.project.data;
---

<article class="card">
  <h2 class="title">{title}</h2>
  <p class="summary">{summary}</p>
  <TagList tags={tags} class="tags" />
  <a class="link repo" href={repo}>{displayUrl(repo)}<span aria-hidden="true"> ↗</span></a>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.5rem;
    border: 1px solid var(--color-line);
    border-radius: 3px;
    background-color: var(--color-surface);
  }

  .title {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .summary {
    margin-top: 0.75rem;
    color: var(--color-muted);
    line-height: 1.6;
  }

  .card :global(.tags) {
    margin-top: 1.25rem;
  }

  .repo {
    margin-top: auto;
    padding-top: 1.25rem;
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    overflow-wrap: anywhere;
  }
</style>
