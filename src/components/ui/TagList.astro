---
import { tagSlug } from '../../lib/content';

interface Props {
  tags: readonly string[];
  /** Link each tag to its blog tag page (/blog/tags/<tag>/). */
  link?: boolean;
  class?: string;
}

const { tags, link = false, class: className } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class:list={['tag-list', className]} aria-label="Tags">
      {tags.map((tag) => (
        <li>{link ? <a href={`/blog/tags/${tagSlug(tag)}/`}>{tag}</a> : <span>{tag}</span>}</li>
      ))}
    </ul>
  )
}

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.4;
  }

  span,
  a {
    display: inline-block;
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--color-line);
    border-radius: 2px;
    color: var(--color-muted);
    text-decoration: none;
  }

  a {
    position: relative;
    z-index: 1;
    transition:
      border-color 150ms,
      color 150ms;
  }

  a:hover {
    border-color: var(--color-accent);
    color: var(--color-fg);
  }
</style>
