---
// Colored ASCII rendering of an image that fills its parent box. WebGL via
// textmode.js when allowed, a static Canvas 2D version otherwise (reduced
// motion, no WebGL2). The parent sets the size; this fills it.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
  src: ImageMetadata | string;
  /** Glyph ramp from dark to bright; by default dense glyphs mark the dark pixels on a light background and the bright ones on a dark background. */
  characters?: string;
  /** Cell size in CSS pixels. */
  cellSize?: number;
  /** Background behind the glyphs (any CSS color); defaults to the page background. */
  background?: string;
  /** Stretch the image's brightness to use the whole ramp (auto-levels). */
  normalize?: boolean;
  /** Describe the image when it carries meaning; decorative by default. */
  alt?: string;
  /** Play the reveal effect once when the live version first appears. */
  intro?: boolean;
  class?: string;
}

const {
  src,
  characters,
  cellSize = 8,
  background,
  normalize = true,
  alt,
  intro = false,
  class: className,
} = Astro.props;

const url = typeof src === 'string' ? src : (await getImage({ src, width: 640, format: 'webp', quality: 82 })).src;
---

<div
  class:list={['ascii-image', className]}
  data-ascii
  data-src={url}
  data-characters={characters}
  data-cell-size={cellSize}
  data-background={background}
  data-normalize={String(normalize)}
  data-ascii-state="idle"
  data-ascii-intro={intro ? '' : undefined}
  style={background && `--ascii-bg: ${background}`}
  role={alt ? 'img' : undefined}
  aria-label={alt}
  aria-hidden={alt ? undefined : 'true'}
>
  <canvas class="ascii-static"></canvas>
  <noscript><img class="ascii-noscript" src={url} alt="" loading="lazy" decoding="async" /></noscript>
</div>

<script>
  import { initAsciiImages } from './runtime';

  // Bundled scripts run once; with client-side navigation, pick up the new
  // page's roots on every page load (initAsciiImages is idempotent).
  initAsciiImages();
  document.addEventListener('astro:page-load', initAsciiImages);
</script>

<style>
  .ascii-image {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background-color: var(--ascii-bg, var(--color-bg));
  }

  .ascii-image :global(canvas),
  .ascii-noscript {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  /* The live canvas fades in over the static one once its first frame is drawn. */
  .ascii-image :global(.ascii-live) {
    opacity: 0;
    transition: opacity 300ms ease-out;
  }

  .ascii-image :global(.ascii-live.is-ready) {
    opacity: 1;
  }

  .ascii-noscript {
    object-fit: cover;
    opacity: 0.55;
  }
</style>
