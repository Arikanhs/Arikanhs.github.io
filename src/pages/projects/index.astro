---
import PageHeader from '../../components/ui/PageHeader.astro';
import ProjectGrid from '../../components/ui/ProjectGrid.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects } from '../../lib/content';

const projects = await getProjects();
---

<BaseLayout title="Projects" description="Research code, tools and side projects by Hasan Serdar Arikan.">
  <div class="container-page">
    <PageHeader title="Projects" lede="Research code, tools and side projects, each with a link to its repository." />
    <ProjectGrid projects={projects} label="Projects" />
  </div>
</BaseLayout>
