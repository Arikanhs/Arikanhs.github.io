---
// Dev-only page (/lab/ascii). The leading underscore keeps Astro from routing it;
// astro.config.mjs injects the route only for `astro dev`, so it never ships.
import { getCollection } from 'astro:content';
import AsciiImage from '../../components/ascii/AsciiImage.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
// Different box shapes show that the ASCII always covers its box: one box per
// shape at least, reusing covers when there are fewer projects than shapes.
const shapes = ['16 / 9', '1 / 1', '3 / 1'];
const boxes = Array.from({ length: Math.max(projects.length, shapes.length) }, (_, i) => ({
  project: projects[i % projects.length],
  shape: shapes[i % shapes.length],
}));
---

<BaseLayout title="ASCII lab" description="Development page for the AsciiImage component.">
  <div class="container-page">
    <PageHeader
      title="ASCII lab"
      path="~/lab/ascii"
      lede="Development only. Tune the AsciiImage component on the project covers."
    />

    <form class="controls" id="lab-controls">
      <div class="field">
        <label for="cell-size">Cell size: <output id="cell-size-value" for="cell-size">8</output> px</label>
        <input id="cell-size" name="cellSize" type="range" min="4" max="24" step="1" value="8" />
      </div>
      <div class="field">
        <label for="characters">Character set, dark to bright</label>
        <input id="characters" name="characters" type="text" value="@%#*+=-:. " spellcheck="false" autocomplete="off" />
      </div>
      <fieldset class="field">
        <legend>Renderer</legend>
        <label><input type="radio" name="renderer" value="auto" checked /> WebGL when allowed</label>
        <label><input type="radio" name="renderer" value="static" /> Canvas 2D fallback</label>
      </fieldset>
    </form>

    <ul class="boxes">
      {
        boxes.map(({ project, shape }) => (
          <li>
            <figure>
              <div class="box" style={`aspect-ratio: ${shape}`}>
                <AsciiImage src={project.data.cover} />
              </div>
              <figcaption>
                {project.data.title} <span class="state">idle</span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<script>
  import type { AsciiConfigureDetail } from '../../components/ascii/runtime';

  const form = document.getElementById('lab-controls') as HTMLFormElement;
  const output = document.getElementById('cell-size-value') as HTMLOutputElement;
  const roots = [...document.querySelectorAll<HTMLElement>('[data-ascii]')];

  const configure = (detail: AsciiConfigureDetail) => {
    for (const root of roots) root.dispatchEvent(new CustomEvent('ascii:configure', { detail }));
  };

  form.addEventListener('submit', (event) => event.preventDefault());
  form.addEventListener('input', (event) => {
    const field = event.target as HTMLInputElement;
    if (field.name === 'cellSize') {
      output.value = field.value;
      configure({ cellSize: Number(field.value) });
    } else if (field.name === 'characters') {
      configure({ characters: field.value });
    } else if (field.name === 'renderer') {
      configure({ forceStatic: field.value === 'static' });
    }
  });

  for (const root of roots) {
    const label = root.closest('figure')?.querySelector('.state');
    const show = () => {
      if (label) label.textContent = `${root.dataset.asciiState} · ${root.dataset.asciiGrid ?? ''}`;
    };
    root.addEventListener('ascii:state', show);
    show();
  }
</script>

<style>
  .controls {
    display: grid;
    gap: 1.25rem;
    padding: 1.25rem;
    border: 1px solid var(--color-line);
    background-color: var(--color-surface);
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  @media (min-width: 48rem) {
    .controls {
      grid-template-columns: 1fr 1.4fr 1fr;
      align-items: start;
    }
  }

  .field {
    display: grid;
    gap: 0.5rem;
  }

  fieldset label {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  legend {
    margin-bottom: 0.5rem;
  }

  input[type='range'] {
    accent-color: var(--color-accent);
  }

  input[type='text'] {
    padding: 0.5rem 0.625rem;
    border: 1px solid var(--color-line);
    background-color: var(--color-bg);
    color: var(--color-fg);
    white-space: pre;
  }

  .boxes {
    margin-top: 2.5rem;
    display: grid;
    gap: 2.5rem;
  }

  .box {
    width: 100%;
    border: 1px solid var(--color-line);
  }

  figcaption {
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  .state {
    margin-left: 0.5rem;
    color: var(--color-faint);
  }
</style>
