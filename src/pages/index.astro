---
import HeroAscii from '../components/ascii/HeroAscii.astro';
import ProjectGrid from '../components/ui/ProjectGrid.astro';
import TerminalHero from '../components/ui/TerminalHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProjects } from '../lib/content';

const featured = (await getProjects()).filter((project) => project.data.featured);
---

<BaseLayout>
  <div class="home-hero">
    <HeroAscii avoid="#hero-terminal" />
    <div class="container-page">
      <TerminalHero />
    </div>
  </div>

  <div class="container-page">
    {
      featured.length > 0 && (
        <section class="selected" aria-labelledby="selected-work">
          <div class="section-head" data-reveal>
            <h2 id="selected-work" class="section-title">
              <span class="prompt" aria-hidden="true">
                ##
              </span>
              Selected work
            </h2>
            <a class="link all" href="/projects/">
              All projects<span aria-hidden="true"> →</span>
            </a>
          </div>
          <ProjectGrid projects={featured} label="Selected work" headingLevel={3} />
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  /* Full-width band behind the hero for the ASCII background. */
  .home-hero {
    position: relative;
    isolation: isolate;
  }

  /* Narrower screens: the shape gets a band below the terminal (wide ones
     have room beside it). Without JS there is no background, so no band. */
  @media (max-width: 69.99rem) {
    :global(html.js) .home-hero {
      padding-bottom: clamp(18rem, 92vw, 30rem);
    }
  }

  .selected {
    margin-top: 0.5rem;
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-bottom: 1.5rem;
  }

  .section-title {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .prompt {
    margin-right: 0.5rem;
    color: var(--color-accent-text);
  }

  .all {
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }
</style>
